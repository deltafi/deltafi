enum SpelExpressionMode {
    CONDITION
    TEMPLATE
}

input SpelContentInput {
    name: String!
    mediaType: String!
    size: Long!
}

input SpelTestDataInput {
    metadata: [KeyValueInput!]
    content: [SpelContentInput!]
    deltaFileName: String
    did: String
}

type SpelTestResult {
    valid: Boolean!
    result: String
    errorMessage: String
    errorPosition: Int
}

extend type Mutation {
    "Test a SpEL expression against sample data"
    testSpelExpression(
        expression: String!
        mode: SpelExpressionMode!
        testData: SpelTestDataInput
    ): SpelTestResult!

    "Validate SpEL expression syntax using synthetic test data"
    validateSpelExpression(
        expression: String!
        mode: SpelExpressionMode!
    ): SpelTestResult!
}
