{
  "name": "hello-world-go-timed-data-source",
  "type": "TIMED_DATA_SOURCE",
  "description": "Hello World Go timed data source",
  "topic": "hello-world-go-data",
  "cronSchedule": "*/5 * * * * *",
  "timedIngressAction": {
    "name": "HelloWorldGoTimedIngressAction",
    "type": "org.deltafi.go-hello-world.HelloWorldGoTimedIngressAction"
  },
  "metadata": {
    "helloKey1": "timed1",
    "helloKey2": "timed2",
    "metaKey3": "go"
  },
  "annotationConfig": {
    "metadataPatterns": [
      "metaKey.*"
    ],
    "discardPrefix": "meta",
    "annotations": {
      "extraAnnot1": "valueA",
      "extraAnnot2": "valueB"
    }
  }
}
