{
  "name": "hello-world-go-transform-many",
  "type": "TRANSFORM",
  "description": "Hello World Go transform many",
  "subscribe": [
    {
      "topic": "hello-world-go-transform-many"
    }
  ],
  "transformActions": [
    {
      "name": "HelloWorldGoSplitTransformAction",
      "type": "org.deltafi.go-hello-world.HelloWorldGoSplitTransformAction",
      "parameters": {
        "numberOfChildren": "${numChildren}"
      }
    }
  ],
  "publish": {
    "matchingPolicy": "FIRST_MATCHING",
    "defaultRule": {
      "defaultBehavior": "ERROR"
    },
    "rules": [
      {
        "topic": "hello-world-go-egress"
      }
    ]
  }
}
