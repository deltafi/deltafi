{
  "name": "deltafi-go-hello-world.transform-lookup-test",
  "description": "Tests Go Hello World lookup table feature",
  "plugins": [
    {
      "groupId": "org.deltafi",
      "artifactId": "deltafi-core-actions",
      "version": "ANY"
    },
    {
      "groupId": "org.deltafi",
      "artifactId": "deltafi-go-hello-world",
      "version": "ANY"
    }
  ],
  "dataSources": [
    "hello-world-go-transform-rest-data-source"
  ],
  "transformationFlows": [
    "hello-world-go-transform"
  ],
  "dataSinks": [
    "hello-world-go-data-sink"
  ],
  "inputs": [
    {
      "dataSource": "hello-world-go-transform-rest-data-source",
      "ingressFileName": "lookup-test.txt",
      "base64Encoded": false,
      "data": "My favorite color is RED",
      "metadata": [
        {
          "key": "index",
          "value": "100"
        }
      ]
    }
  ],
  "timeout": "PT90S",
  "expectedDeltaFiles": [
    {
      "stage": "COMPLETE",
      "childCount": 0,
      "expectedFlows": [
        {
          "flow": "hello-world-go-transform-rest-data-source",
          "type": "REST_DATA_SOURCE",
          "actions": [
            "IngressAction"
          ]
        },
        {
          "flow": "hello-world-go-transform",
          "type": "TRANSFORM",
          "actions": [
            "HelloWorldGoTransformAction"
          ]
        },
        {
          "flow": "hello-world-go-data-sink",
          "type": "DATA_SINK",
          "actions": [
            "HelloWorldGoEgressAction"
          ],
          "metadata": {
            "containsKeys": [
              "colorTableCreated",
              "colorTableLastModified",
              "purpleCreated",
              "purpleModified"
            ],
            "keyValueMatchers": [
              {
                "name": "McLaren Drivers",
                "value": "Oscar Piastri, Lando Norris",
                "exact": true
              },
              {
                "name": "purpleCount",
                "value": "0",
                "exact": true
              },
              {
                "name": "RGB Rows",
                "value": ".*A3.*",
                "exact": false
              }
            ]
          }
        }
      ],
      "expectedContent": {
        "flow": "hello-world-go-data-sink",
        "type": "DATA_SINK",
        "action": "HelloWorldGoEgressAction",
        "data": [
          {
            "name": "content-100",
            "mediaType": "text/plain",
            "contains": [
              "My favorite color is RED",
              "HelloWorldGoTransformAction did a great job"
            ]
          }
        ]
      }
    }
  ]
}
