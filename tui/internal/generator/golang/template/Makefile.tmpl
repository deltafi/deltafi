.DEFAULT_GOAL := build
APP_NAME := {{.PluginName}}
DOCKER_REPO := deltafi/{{.PluginName}}
ADDITIONAL_DOCKER_ARGS ?=
SBOM ?= true
BUILDX_BUILDER ?= deltafi-golang-plugin

# Local action kit development (for build/test targets, not docker image builds)
LOCAL_GO_ACTION_KIT ?= false
LOCAL_GO_ACTION_KIT_PATH ?= ../deltafi/deltafi-go-action-kit
ACTION_KIT_MODULE := gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2

# Build info
BUILD_DIR ?= $(realpath $(CURDIR))
VERSION ?= $(shell git describe --tags --always --dirty=-local 2>/dev/null || echo latest)

# Plugin identity is read from plugin.yaml and stamped into the binary via
# -ldflags at docker build time. awk strips the "key:" prefix and any
# surrounding quotes, preserving the rest of the value verbatim (including any
# colons, e.g. in a description); values are passed to docker as --build-arg.
PLUGIN_GROUP_ID    := $(shell awk '/^groupId:/     {sub(/^groupId:[ \t]*/,"");     gsub(/^"|"$$/,""); print; exit}' plugin.yaml 2>/dev/null)
PLUGIN_ARTIFACT_ID := $(shell awk '/^artifactId:/  {sub(/^artifactId:[ \t]*/,"");  gsub(/^"|"$$/,""); print; exit}' plugin.yaml 2>/dev/null)
PLUGIN_DOMAIN      := $(shell awk '/^domain:/      {sub(/^domain:[ \t]*/,"");      gsub(/^"|"$$/,""); print; exit}' plugin.yaml 2>/dev/null)
PLUGIN_DESCRIPTION := $(shell awk '/^description:/ {sub(/^description:[ \t]*/,""); gsub(/^"|"$$/,""); print; exit}' plugin.yaml 2>/dev/null)

GOPATH ?= $(CURDIR)/.go
export GOPATH

# When running inside a web terminal container, Docker volume mounts must use
# host paths. HOST_REPOS_DIR maps /deltafi/repos to the host equivalent.
ifdef HOST_REPOS_DIR
  HOST_BUILD_DIR := $(subst /deltafi/repos,$(HOST_REPOS_DIR),$(BUILD_DIR))
  HOST_GOPATH := $(HOST_BUILD_DIR)/.go
else
  HOST_BUILD_DIR := $(BUILD_DIR)
  HOST_GOPATH := $(GOPATH)
endif

# Auto-detect if go is installed
HAS_GO := $(shell command -v go 2> /dev/null)
USE_DOCKER ?= $(if $(HAS_GO),false,true)

# Environment checks
NATIVE_ARCH ?= $(strip $(shell uname -m | tr A-Z a-z))
ifneq ($(NATIVE_ARCH),arm64)
  ifneq ($(NATIVE_ARCH),amd64)
    NATIVE_ARCH := amd64
  endif
endif

NATIVE_OS := $(shell basename $(shell uname -o | tr A-Z a-z))
ifneq ($(NATIVE_OS),darwin)
  NATIVE_OS := linux
endif

HAS_DOCKER := $(shell command -v docker 2> /dev/null)
MIN_GO_VERSION := 1.26
GO_VERSION_CHECK := $(if $(HAS_GO),$(shell go version 2>/dev/null | grep -q "go$(MIN_GO_VERSION)" && echo 1 || echo 0),0)

GOBINPATH = $(GOPATH)/bin

# Docker build settings
DOCKER_IMAGE := golang:1.26-alpine
DOCKER_SOURCE := /go/src/{{.PluginName}}
DOCKER_WORKDIR := $(DOCKER_SOURCE)
DOCKER_GOPATH := $(DOCKER_WORKDIR)/.go
DOCKER_USER := $(shell id -u):$(shell id -g)

# Local action kit: set GOWORK as a command prefix so every go invocation sees it,
# and mount the action kit so the relative path resolves inside docker run containers.
DOCKER_EXTRA_VOLUMES :=
DOCKER_GOWORK_ENV :=
GOWORK_ENV := GOWORK=off
ifeq ($(LOCAL_GO_ACTION_KIT),true)
  LOCAL_GO_ACTION_KIT_ABS := $(realpath $(LOCAL_GO_ACTION_KIT_PATH))
  ACTIONKIT_VERSION ?= $(shell cd $(LOCAL_GO_ACTION_KIT_ABS) && git describe --tags --always --dirty=-local 2>/dev/null || echo latest)
  DOCKER_KIT_RUN_MOUNT := $(shell python3 -c "import posixpath; print(posixpath.normpath(posixpath.join('$(DOCKER_WORKDIR)', '$(LOCAL_GO_ACTION_KIT_PATH)')))")
  DOCKER_EXTRA_VOLUMES := -v $(LOCAL_GO_ACTION_KIT_ABS):$(DOCKER_KIT_RUN_MOUNT)
  DOCKER_GOWORK_ENV := -e GOWORK=$(DOCKER_WORKDIR)/go.work -e ACTIONKIT_VERSION=$(ACTIONKIT_VERSION) -e VERSION=$(VERSION)-local
  GOWORK_ENV := GOWORK=$(CURDIR)/go.work
endif

# Docker image build args/contexts. The single Dockerfile selects between
# published-mode and local-mode via KIT_SOURCE; in local mode the action kit
# working copy is mounted via --build-context.
DOCKER_BUILD_ARGS     := --build-arg VERSION=$(VERSION) \
                         --build-arg PLUGIN_GROUP_ID=$(PLUGIN_GROUP_ID) \
                         --build-arg PLUGIN_ARTIFACT_ID=$(PLUGIN_ARTIFACT_ID) \
                         --build-arg PLUGIN_DOMAIN=$(PLUGIN_DOMAIN) \
                         --build-arg PLUGIN_DESCRIPTION='$(PLUGIN_DESCRIPTION)'
DOCKER_BUILD_CONTEXTS :=
ifeq ($(LOCAL_GO_ACTION_KIT),true)
  DOCKER_BUILD_ARGS     += --build-arg KIT_SOURCE=local --build-arg ACTIONKIT_VERSION=$(ACTIONKIT_VERSION)
  DOCKER_BUILD_CONTEXTS += --build-context action-kit=$(LOCAL_GO_ACTION_KIT_ABS)
endif

# Wiring shared by both DOCKER_CMD (uses the host OS) and DOCKER_TOOLING_CMD
# (always linux, used for downloading and building developer tools).
DOCKER_RUN_COMMON := --rm \
              --user $(DOCKER_USER) \
              -v $(HOST_BUILD_DIR):$(DOCKER_SOURCE) \
              -v $(HOST_GOPATH):$(DOCKER_GOPATH) \
              $(DOCKER_EXTRA_VOLUMES) \
              $(DOCKER_GOWORK_ENV) \
              -e GOPATH=$(DOCKER_GOPATH) \
              -e GOFLAGS=-modcacherw \
              -e CGO_ENABLED=0 \
              -e GOARCH=$(NATIVE_ARCH) \
              -e GOCACHE=/tmp/.cache \
              -w $(DOCKER_WORKDIR)

DOCKER_CMD         := docker run $(DOCKER_RUN_COMMON) -e GOOS=$(NATIVE_OS)
DOCKER_TOOLING_CMD := docker run --platform linux/$(NATIVE_ARCH) $(DOCKER_RUN_COMMON) -e GOOS=linux

# Conditionally prefix commands with docker
ifeq ($(USE_DOCKER),true)
  ifeq ($(HAS_DOCKER),)
    $(error Docker or golang installation is required)
  endif
  CMD_PREFIX := $(DOCKER_CMD) $(DOCKER_IMAGE)
  TOOLING_CMD_PREFIX := $(DOCKER_TOOLING_CMD) $(DOCKER_IMAGE)
  GOBINPATH := $(DOCKER_GOPATH)/bin
else
  ifeq ($(HAS_GO),)
    $(error Go installation or docker is required)
  endif
  ifeq ($(GO_VERSION_CHECK), 0)
    $(warning Go $(MIN_GO_VERSION) or higher is required. Consider using USE_DOCKER=true)
  endif
  CMD_PREFIX :=
  TOOLING_CMD_PREFIX :=
  GOBINPATH := $(GOPATH)/bin
endif

# Go commands (GOWORK_ENV ensures workspace is respected for local action kit builds)
GOCMD     = $(GOWORK_ENV) $(CMD_PREFIX) go
GOTOOLCMD = $(GOWORK_ENV) $(TOOLING_CMD_PREFIX) go
GOBUILD   = $(GOCMD) build -modcacherw
GOCLEAN   = $(GOCMD) clean
GOTEST    = $(GOTOOLCMD) test -modcacherw
GOTEST_RACE_RUN ?= CGO_ENABLED=1 $(GOTEST) -v -race ./...
GOGET     = $(GOCMD) get -modcacherw
GOVET     = $(GOCMD) vet -modcacherw
GOFIX     = $(GOCMD) fix -modcacherw
GOFMT     = $(GOCMD) fmt -modcacherw
GOTIDY    = $(GOCMD) mod tidy -modcacherw
GOLINT    = $(CMD_PREFIX) $(GOBINPATH)/golangci-lint
GOINSTALL = $(GOCMD) install -modcacherw

# Extra modules
LINT_MODULE = github.com/golangci/golangci-lint/cmd/golangci-lint@latest

# Output
BIN_DIR = ./bin

.PHONY: all build clean test acceptance-test lint fmt deps tidy very-clean docker docker-build docker-tag publish install help check-env check-plugin-yaml sync-action-kit buildx-builder jsonFromParams paramsFromJson

all: check-env build test

# Manage go.work for local action kit development.
# When LOCAL_GO_ACTION_KIT=true, creates a go.work that redirects the action kit
# to the local path without modifying go.mod. When false, removes go.work so
# published modules are used. go.work and go.work.sum should be gitignored.
sync-action-kit:
	@mkdir -p $(GOPATH)
ifeq ($(LOCAL_GO_ACTION_KIT),true)
	@echo "Using local Go action kit: $(LOCAL_GO_ACTION_KIT_ABS)"
	@rm -f go.work go.work.sum
	@$(GOCMD) work init .
	@$(GOCMD) work edit -replace $(ACTION_KIT_MODULE)=$(LOCAL_GO_ACTION_KIT_PATH)
	@cat go.work
else
	@rm -f go.work go.work.sum
endif


# Validate plugin.yaml is present and has all required keys before running any
# build target. Values are read into the PLUGIN_* variables at the top of this
# Makefile; this rule converts missing values into a clear error message.
check-plugin-yaml:
	@if [ ! -f plugin.yaml ]; then \
		echo "ERROR: plugin.yaml not found in $(CURDIR)" >&2; \
		echo "Create plugin.yaml with required keys: groupId, artifactId, domain, description" >&2; \
		exit 1; \
	fi
	@missing=""; \
	[ -z "$(PLUGIN_GROUP_ID)" ] && missing="$$missing groupId"; \
	[ -z "$(PLUGIN_ARTIFACT_ID)" ] && missing="$$missing artifactId"; \
	[ -z "$(PLUGIN_DOMAIN)" ] && missing="$$missing domain"; \
	[ -z "$(PLUGIN_DESCRIPTION)" ] && missing="$$missing description"; \
	if [ -n "$$missing" ]; then \
		echo "ERROR: plugin.yaml is missing required keys:$$missing" >&2; \
		exit 1; \
	fi

check-env: check-plugin-yaml sync-action-kit
	@mkdir -p $(GOPATH)
	@if [ "$(USE_DOCKER)" = "false" ] && [ "$(GO_VERSION_CHECK)" = "0" ]; then \
		echo "WARNING: Go $(MIN_GO_VERSION) is required. Consider using USE_DOCKER=true"; \
	fi
	@if [ "$(USE_DOCKER)" = "true" ]; then \
		echo "Using Docker GO environment [ $(NATIVE_OS) $(NATIVE_ARCH) ]"; \
	fi

help:
	@echo "Version:     " $(VERSION)
	@echo ""
	@echo "Build environment:"
	@echo "  Has Go:      " $(if $(HAS_GO),yes,no)
	@echo "  Has Docker:  " $(if $(HAS_DOCKER),yes,no)
	@echo "  Using Docker:" $(USE_DOCKER)
	@echo "  GOPATH:      " $(GOPATH)
	@echo ""
	@echo "Available targets:"
	@echo "  all              - Build and run tests"
	@echo "  build            - Build binary"
	@echo "  clean            - Remove build artifacts"
	@echo "  very-clean       - Remove build artifacts and cached modules"
	@echo "  test             - Run tests"
	@echo "  acceptance-test  - Run tests with the race detector"
	@echo "  lint             - Run linter and vet"
	@echo "  fmt              - Format code"
	@echo "  tidy             - Format code and tidy modules"
	@echo "  deps             - Install dependencies"
	@echo "  deps-up          - Upgrade dependencies to latest versions"
	@echo "  upgrade          - Upgrade dependencies, tidy, and lint"
	@echo "  docker           - Build Docker image (tagged :latest and :VERSION)"
	@echo "  docker-build     - Build Docker image (tagged :latest)"
	@echo "  docker-tag       - Tag Docker image with version"
	@echo "  publish          - Build and publish multi-architecture Docker container"
	@echo "  install          - Build Docker image and install plugin into DeltaFi"
	@echo "  jsonFromParams   - Regenerate action_params.json from each _params.go"
	@echo "  paramsFromJson   - Regenerate action_params.go from each _params.json"
	@echo ""
	@echo "Build options:"
	@echo "  USE_DOCKER=true|false             - Use Docker for building (auto-detected: $(USE_DOCKER))"
	@echo "  LOCAL_GO_ACTION_KIT=true|false    - Use a local Go action kit (default: $(LOCAL_GO_ACTION_KIT))"
	@echo "  LOCAL_GO_ACTION_KIT_PATH=<path>   - Path to local action kit (default: $(LOCAL_GO_ACTION_KIT_PATH))"
	@echo "  BUILDX_BUILDER=<name>             - buildx builder name used by publish (default: $(BUILDX_BUILDER))"

build: tidy
	@echo "Building $(BIN_DIR)/$(APP_NAME)"
	@mkdir -p $(BIN_DIR)
	@$(GOBUILD) -o $(BIN_DIR)/$(APP_NAME) .

test: tidy
	@echo "Running all tests"
	@$(GOTEST) -v ./...

acceptance-test: check-env
	@echo "Running all tests with the race detector"
	@$(GOTEST_RACE_RUN)

clean: check-env
	$(GOCLEAN)
	rm -rf $(BIN_DIR)

very-clean: clean
	$(GOCLEAN) -modcache
	rm -rf $(GOPATH)

lint: deps
	@echo "Running static analysis"
	@$(GOFIX) ./...
	@$(GOVET) ./...
	@$(GOLINT) run

fmt: check-env
	@echo $(GOFMT) ./...
	@$(GOFMT) ./...

tidy: check-env fmt
ifeq ($(LOCAL_GO_ACTION_KIT),true)
	@trap '$(GOCMD) mod edit -dropreplace=$(ACTION_KIT_MODULE)' EXIT; \
	$(GOCMD) mod edit -replace=$(ACTION_KIT_MODULE)=$(LOCAL_GO_ACTION_KIT_PATH) && \
	$(GOTIDY)
else
	@$(GOTIDY)
endif

deps: check-env
	@$(GOGET) ./...
	@$(GOINSTALL) $(LINT_MODULE)

# Docker targets
docker: docker-build docker-tag

# Ensure a dedicated buildx builder exists for multi-platform plugin builds.
buildx-builder:
	@docker buildx inspect $(BUILDX_BUILDER) >/dev/null 2>&1 || docker buildx create --name $(BUILDX_BUILDER) --driver docker-container >/dev/null

docker-build: check-env
	@echo "Building Docker image $(DOCKER_REPO):latest"
	@echo docker build $(DOCKER_BUILD_CONTEXTS) $(DOCKER_BUILD_ARGS) -t $(DOCKER_REPO):latest $(HOST_BUILD_DIR)
	docker build $(DOCKER_BUILD_CONTEXTS) $(DOCKER_BUILD_ARGS) -t $(DOCKER_REPO):latest $(HOST_BUILD_DIR)

publish: check-env buildx-builder
	@echo "Publishing docker image for $(DOCKER_REPO):$(VERSION)"
	@docker buildx build --builder $(BUILDX_BUILDER) --no-cache $(ADDITIONAL_DOCKER_ARGS) $(DOCKER_BUILD_CONTEXTS) $(DOCKER_BUILD_ARGS) --provenance=$(SBOM) --sbom=$(SBOM) --push --platform linux/amd64,linux/arm64 --tag $(DOCKER_REPO):$(VERSION) $(HOST_BUILD_DIR)

docker-tag: docker-build
	@echo "Tagging $(DOCKER_REPO):$(VERSION)"
	docker tag $(DOCKER_REPO):latest $(DOCKER_REPO):$(VERSION)

install: docker
	@echo "Installing $(DOCKER_REPO):$(VERSION)"
	deltafi plugin install --wait "$(DOCKER_REPO):$(VERSION)"

.PHONY: upgrade deps-up
upgrade: check-env deps-up tidy lint

deps-up: check-env
	@$(GOGET) -u ./...

# Schema round-trip targets. jsonFromParams writes <actions/*_action_params.json>
# alongside each *_action_params.go. paramsFromJson does the reverse (overwrites
# the .go files with regenerated source; fields alphabetize, comments drop —
# see the kit's cmd/actionkit-schemagen for details).
jsonFromParams:
	@go run gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2/cmd/actionkit-schemagen json ./actions

paramsFromJson:
	@go run gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2/cmd/actionkit-schemagen params ./actions
