func (a *{{.ActionClassName}}) Transform(deltafile *actionkit.Deltafile, params {{.ActionClassName}}Params) *actionkit.Deltafile {

	content, err := deltafile.ContentAt(0)
	if err != nil {
		return deltafile.Errorf("No content provided")
	}

	data, err := content.LoadString()
	if err != nil {
		return deltafile.Errorf("Failed to load content: %v", err)
	}

	// TODO: Implement your transformation logic here
	transformed := data

	_, err = deltafile.SaveStringContent(transformed, content.Name+"-transformed", content.MediaType)
	if err != nil {
		return deltafile.Errorf("Failed to save content: %v", err)
	}

