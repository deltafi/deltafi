// ABOUTME: Tests for {{.ActionClassName}}.
// ABOUTME: Covers first run, memo increment, and content creation.

package actions

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func Test{{.ActionClassName}}_FirstRun(t *testing.T) {
	tc := actionkit.NewTestContext("ingress-did")
	tc.FlowName = "{{.ActionName}}-data-source"

	deltafile := tc.NewTimedIngressDeltafile()
	event := actionkit.RunIngress(t, &{{.ActionClassName}}{}, deltafile, {{.ActionClassName}}Params{})
	ingress := event.RequireIngress(t)

	require.Equal(t, "0", ingress.Memo)
	assert.False(t, ingress.ExecuteImmediate)
	require.Len(t, ingress.IngressItems, 1)

	item := ingress.IngressItems[0]
	assert.Equal(t, "{{.ActionName}}-data-source-0", item.DeltaFileName)
	assert.Equal(t, "0", item.Metadata["index"])

	require.Len(t, item.Content, 1)
	data, err := item.Content[0].LoadString()
	require.NoError(t, err)
	assert.Equal(t, "Ingress content, part 0", data)
}

func Test{{.ActionClassName}}_IncrementsMemo(t *testing.T) {
	tc := actionkit.NewTestContext("ingress-did")
	tc.FlowName = "{{.ActionName}}-data-source"
	tc.Memo = "4"

	deltafile := tc.NewTimedIngressDeltafile()
	event := actionkit.RunIngress(t, &{{.ActionClassName}}{}, deltafile, {{.ActionClassName}}Params{})
	ingress := event.RequireIngress(t)

	assert.Equal(t, "5", ingress.Memo)
	assert.Equal(t, "5", ingress.IngressItems[0].Metadata["index"])
}
