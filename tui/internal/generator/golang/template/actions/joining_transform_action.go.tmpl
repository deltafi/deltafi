// Join aggregates multiple inputs into a single input for the Transform phase.
// Failures during join should panic with a meaningful message; the worker
// recovers panics and turns them into ErrorResults.
func (a *{{.ActionClassName}}) Join(ctx context.Context, inputs []actionkit.TransformInput) actionkit.TransformInput {
	var allContent []actionkit.ActionContent
	allMetadata := make(map[string]string)

	// TODO: Implement your join aggregation logic here
	for _, input := range inputs {
		allContent = append(allContent, input.Content...)
		maps.Copy(allMetadata, input.Metadata)
	}

	return actionkit.TransformInput{
		ActionContext: inputs[0].ActionContext,
		Content:       allContent,
		Metadata:      allMetadata,
		Params:        inputs[0].Params,
	}
}

// Transform processes the joined input and creates the final output.
func (a *{{.ActionClassName}}) Transform(ctx context.Context, input actionkit.TransformInput) actionkit.Result {
	actx := input.ActionContext

	// TODO: Implement your transform logic on the joined input
	var contentBuilder strings.Builder
	for i := range input.Content {
		content, err := input.ContentAt(i)
		if err != nil {
			return actx.Errorf("Failed to get content at index %d: %v", i, err)
		}
		data, err := content.LoadString(ctx)
		if err != nil {
			return actx.Errorf("Failed to load content at index %d: %v", i, err)
		}
		contentBuilder.WriteString(data)
		contentBuilder.WriteString("\n")
	}

	mergedContent, err := actx.SaveString(ctx, contentBuilder.String(), "merged", "text/plain")
	if err != nil {
		return actx.Errorf("Failed to save merged content: %v", err)
	}

	result := actionkit.NewTransformResult(actx).AddContent(*mergedContent)

	for k, v := range input.Metadata {
		result.AddMetadata(k, v)
	}

	return result.LogInfo("Joined %d content items", len(input.Content))
}
