package actions

import (
	_ "embed"
	"strings"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

//go:embed {{.ActionFileName}}_action.yaml
var {{.ActionFileName}}Options string

func init() {
	actionkit.RegisterJoinTransform("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		WithOptionsYAML({{.ActionFileName}}Options)

	// Uncomment to register with parameters:
	// actionkit.RegisterJoinTransform("{{.ActionClassName}}", &{{.ActionClassName}}{}).
	// 	WithParams({{.ActionClassName}}Params{}).
	// 	WithOptionsYAML({{.ActionFileName}}Options)
}

// {{.ActionClassName}} implements the joining transform action.
type {{.ActionClassName}} struct{}

// Join aggregates multiple inputs into a single Deltafile for the Transform phase.
// Return joined for success, or joined.Errorf/Filterf to short-circuit.
func (a *{{.ActionClassName}}) Join(inputs []*actionkit.Deltafile, joined *actionkit.Deltafile, params {{.ActionClassName}}Params) *actionkit.Deltafile {
	if len(inputs) == 0 {
		return joined.Errorf("No inputs to join")
	}

	// TODO: Implement your join aggregation logic here
	for _, input := range inputs {
		joined.AddContentList(input.GetContentList())
		joined.AddMetadataMap(input.GetMetadataMap())
	}

	if !joined.HasContent() {
		return joined.Errorf("All inputs were empty")
	}

	return joined
}

// Transform processes the joined input and creates the final output.
func (a *{{.ActionClassName}}) Transform(deltafile *actionkit.Deltafile, params {{.ActionClassName}}Params) *actionkit.Deltafile {

	// TODO: Implement your transform logic on the joined input
	var contentBuilder strings.Builder
	for i := range deltafile.GetContentList() {
		content, err := deltafile.ContentAt(i)
		if err != nil {
			return deltafile.Errorf("Failed to get content at index %d: %v", i, err)
		}
		data, err := content.LoadString()
		if err != nil {
			return deltafile.Errorf("Failed to load content at index %d: %v", i, err)
		}
		contentBuilder.WriteString(data)
		contentBuilder.WriteString("\n")
	}

	_, err := deltafile.SaveStringContent("merged", "text/plain", contentBuilder.String())
	if err != nil {
		return deltafile.Errorf("Failed to save merged content: %v", err)
	}

	return deltafile.
		AddMetadataMap(deltafile.GetMetadataMap()).
		LogInfo("Joined %d content items", len(deltafile.GetContentList()))
}
