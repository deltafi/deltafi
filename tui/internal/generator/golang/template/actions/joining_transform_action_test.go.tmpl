// ABOUTME: Tests for {{.ActionClassName}}.
// ABOUTME: Covers join aggregation and transform of merged content.

package actions

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func Test{{.ActionClassName}}_Join(t *testing.T) {
	tc := actionkit.NewTestContext("join-did")
	content1 := tc.Content("part1.txt", "text/plain", "first")
	content2 := tc.Content("part2.txt", "text/plain", "second")

	in1 := tc.NewDeltafile(content1)
	in1.AddMetadata("key", "a")
	in2 := tc.NewDeltafile(content2)
	in2.AddMetadata("key", "b")

	joined := tc.NewDeltafile()
	result := actionkit.RunJoin(t, &{{.ActionClassName}}{}, []*actionkit.Deltafile{in1, in2}, joined, {{.ActionClassName}}Params{})

	require.True(t, result.HasContent())
	assert.Len(t, result.GetNewContentSlice(), 2)
}

func Test{{.ActionClassName}}_Transform(t *testing.T) {
	tc := actionkit.NewTestContext("join-did")
	content1 := tc.Content("p1.txt", "text/plain", "AAA")
	content2 := tc.Content("p2.txt", "text/plain", "BBB")

	deltafile := tc.NewDeltafile(content1, content2)
	deltafile.AddMetadata("hello", "world")

	event := actionkit.RunTransform(t, &{{.ActionClassName}}{}, deltafile, {{.ActionClassName}}Params{})
	te := event.RequireTransform(t)

	require.Len(t, te, 1)
	data, err := te[0].Content[0].LoadString()
	require.NoError(t, err)
	assert.Contains(t, data, "AAA")
	assert.Contains(t, data, "BBB")
	assert.Equal(t, "world", te[0].Metadata["hello"])
}
