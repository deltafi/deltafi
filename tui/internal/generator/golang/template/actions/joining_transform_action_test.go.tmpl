// ABOUTME: Tests for {{.ActionClassName}}.
// ABOUTME: Covers join aggregation and transform of merged content.

package actions

import (
	"context"
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func Test{{.ActionClassName}}_Join(t *testing.T) {
	tc := actionkit.NewTestContext("join-did")
	content1 := tc.Content("part1.txt", "text/plain", "first")
	content2 := tc.Content("part2.txt", "text/plain", "second")

	in1 := actionkit.NewTransformInput(tc, content1)
	in1.Metadata = map[string]string{"key": "a"}
	in2 := actionkit.NewTransformInput(tc, content2)
	in2.Metadata = map[string]string{"key": "b"}

	merged := (&{{.ActionClassName}}{}).Join(context.Background(), []actionkit.TransformInput{in1, in2})

	require.Len(t, merged.Content, 2)
	assert.Equal(t, "part1.txt", merged.Content[0].Name)
	assert.Equal(t, "part2.txt", merged.Content[1].Name)
}

func Test{{.ActionClassName}}_Transform(t *testing.T) {
	tc := actionkit.NewTestContext("join-did")
	content1 := tc.Content("p1.txt", "text/plain", "AAA")
	content2 := tc.Content("p2.txt", "text/plain", "BBB")

	input := actionkit.NewTransformInput(tc, content1, content2)
	input.Metadata = map[string]string{"hello": "world"}

	event := actionkit.RunTransform(t, &{{.ActionClassName}}{}, input)
	te := event.RequireTransform(t)

	require.Len(t, te, 1)
	data, err := te[0].Content[0].LoadString(context.Background())
	require.NoError(t, err)
	assert.Contains(t, data, "AAA")
	assert.Contains(t, data, "BBB")
	assert.Equal(t, "world", te[0].Metadata["hello"])
}
