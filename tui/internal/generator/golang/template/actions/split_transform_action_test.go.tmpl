// ABOUTME: Tests for {{.ActionClassName}}.
// ABOUTME: Covers multi-child creation from content items.

package actions

import (
	"testing"

	"github.com/stretchr/testify/assert"
	"github.com/stretchr/testify/require"
	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func Test{{.ActionClassName}}_SplitsContentIntoChildren(t *testing.T) {
	tc := actionkit.NewTestContext("split-did")
	c1 := tc.Content("file1.txt", "text/plain", "data1")
	c2 := tc.Content("file2.txt", "text/plain", "data2")

	df := tc.NewDeltafile(c1, c2)
	df.AddMetadata("key", "value")

	event := actionkit.RunTransform(t, &{{.ActionClassName}}{}, df, {{.ActionClassName}}Params{})
	te := event.RequireTransform(t)

	require.Len(t, te, 2)

	for i, child := range te {
		require.Len(t, child.Content, 1, "child %d", i)
		assert.Equal(t, "value", child.Metadata["key"], "child %d metadata", i)
	}
}

func Test{{.ActionClassName}}_NoContent(t *testing.T) {
	tc := actionkit.NewTestContext("split-did")

	df := tc.NewDeltafile()
	event := actionkit.RunTransform(t, &{{.ActionClassName}}{}, df, {{.ActionClassName}}Params{})
	te := event.RequireTransform(t)
	assert.Len(t, te, 0)
}
