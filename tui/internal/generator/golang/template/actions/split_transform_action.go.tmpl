package actions

import (
	_ "embed"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

//go:embed {{.ActionFileName}}_action.yaml
var {{.ActionFileName}}Options string

func init() {
	actionkit.RegisterTransform("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		WithParams({{.ActionClassName}}Params{}).
		WithOptionsYAML({{.ActionFileName}}Options)
}

// {{.ActionClassName}}Params defines the action's configurable parameters.
type {{.ActionClassName}}Params struct{}

// {{.ActionClassName}} splits input into multiple child DeltaFiles.
type {{.ActionClassName}} struct{}

func (a *{{.ActionClassName}}) Transform(df *actionkit.Deltafile, params {{.ActionClassName}}Params) *actionkit.Deltafile {
	for _, content := range df.GetContentSlice() {
		child := df.NewChild(content.Name)
		child.AddContent(content)
		child.AddMetadataMap(df.GetMetadataMap())
	}
	return df
}
