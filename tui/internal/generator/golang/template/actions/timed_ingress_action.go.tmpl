// ABOUTME: Timed ingress action that creates DeltaFiles on a schedule.
// ABOUTME: Modify this file to implement your ingress logic.

package actions

import (
	"context"
	"fmt"
	"strconv"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func init() {
	actionkit.Register("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		Describe("TODO: Add action description")
}

// {{.ActionClassName}} implements the timed ingress action.
type {{.ActionClassName}} struct{}

func (a *{{.ActionClassName}}) Ingress(ctx context.Context, input actionkit.IngressInput) actionkit.Result {
	actx := input.ActionContext

	// Parse index from memo (defaults to 0, increments each run)
	index := 0
	if actx.Memo != "" {
		if parsed, err := strconv.Atoi(actx.Memo); err == nil {
			index = parsed + 1
		}
	}

	filename := fmt.Sprintf("%s-%d", actx.FlowName, index)

	// TODO: Implement your ingress logic here (e.g., fetch from external system)
	contentData := fmt.Sprintf("Ingress content, part %d", index)

	content, err := actx.SaveString(ctx, contentData, filename, "text/plain")
	if err != nil {
		return actx.Errorf("Failed to save content: %v", err)
	}

	item := actionkit.NewIngressResultItem(filename).
		AddMetadata("index", strconv.Itoa(index)).
		AddContent(*content)

	return actionkit.NewIngressResult(actx).
		AddItem(*item).
		SetMemo(strconv.Itoa(index)).
		SetExecuteImmediate(false).
		SetStatusMessage(fmt.Sprintf("Created %s", filename)).
		LogInfo("Created ingress file: %s (index=%d)", filename, index)
}
