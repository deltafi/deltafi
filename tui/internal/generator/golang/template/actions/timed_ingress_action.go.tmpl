// ABOUTME: Timed ingress action that creates DeltaFiles on a schedule.
// ABOUTME: Modify this file to implement your ingress logic.

package actions

import (
	_ "embed"
	"fmt"
	"strconv"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

//go:embed {{.ActionFileName}}_action.yaml
var {{.ActionFileName}}Options string

func init() {
	actionkit.RegisterIngress("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		WithOptionsYAML({{.ActionFileName}}Options)
}

// {{.ActionClassName}} implements the timed ingress action.
type {{.ActionClassName}} struct{}

func (a *{{.ActionClassName}}) Ingress(deltafile *actionkit.TimedIngressDeltafile, params {{.ActionClassName}}Params) *actionkit.TimedIngressDeltafile {

	// Parse index from memo (defaults to 0, increments each run)
	index := 0
	if deltafile.Memo != "" {
		if parsed, err := strconv.Atoi(deltafile.Memo); err == nil {
			index = parsed + 1
		}
	}

	filename := fmt.Sprintf("%s-%d", deltafile.FlowName, index)

	// TODO: Implement your ingress logic here (e.g., fetch from external system)
	contentData := fmt.Sprintf("Ingress content, part %d", index)

	item := deltafile.NewItem(filename)
	if _, err := item.SaveStringContent(filename, "text/plain", contentData); err != nil {
		return deltafile.Errorf("Failed to save content: %v", err)
	}
	item.AddMetadata("index", strconv.Itoa(index))

	return deltafile.
		SetMemo(strconv.Itoa(index)).
		SetExecuteImmediate(false).
		SetStatusMessage(fmt.Sprintf("Created %s", filename)).
		LogInfo("Created ingress file: %s (index=%d)", filename, index)
}
