// ABOUTME: Egress action that sends content to an external destination.
// ABOUTME: Modify this file to implement your egress logic.

package actions

import (
	_ "embed"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

//go:embed {{.ActionFileName}}_action.yaml
var {{.ActionFileName}}Options string

func init() {
	actionkit.RegisterEgress("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		WithOptionsYAML({{.ActionFileName}}Options)
}

// {{.ActionClassName}} implements the egress action.
type {{.ActionClassName}} struct{}

func (a *{{.ActionClassName}}) Egress(deltafile *actionkit.EgressDeltafile, params {{.ActionClassName}}Params) *actionkit.EgressDeltafile {

	if !deltafile.HasContent() {
		return deltafile.Errorf("No content provided")
	}
	content, err := deltafile.FirstContent()
	if err != nil {
		return deltafile.Errorf("Failed to get content: %v", err)
	}

	data, err := content.LoadString()
	if err != nil {
		return deltafile.Errorf("Failed to load content: %v", err)
	}

	// TODO: Implement your egress logic here (e.g., send to external system)
	_ = data

	for key, value := range deltafile.GetMetadataMap() {
		deltafile.LogInfo("Metadata - %s: %s", key, value)
	}

	return deltafile.
		LogInfo("Egressed %d bytes", len(data)).
		LogInfo("Content name: %s, type: %s", content.Name, content.MediaType)
}
