package actions

import (
	"context"

	actionkit "gitlab.com/deltafi/deltafi/deltafi-go-action-kit/v2"
)

func init() {
	actionkit.Register("{{.ActionClassName}}", &{{.ActionClassName}}{}).
		Describe("TODO: Add action description")
}

// {{.ActionClassName}} implements the egress action.
type {{.ActionClassName}} struct{}

func (a *{{.ActionClassName}}) Egress(ctx context.Context, input actionkit.EgressInput) actionkit.Result {
	actx := input.ActionContext

	if !input.HasContent() {
		return actx.Errorf("No content provided")
	}
	content := input.FirstContent()

	data, err := content.LoadString(ctx)
	if err != nil {
		return actx.Errorf("Failed to load content: %v", err)
	}

	// TODO: Implement your egress logic here (e.g., send to external system)
	_ = data

	result := actionkit.NewEgressResult(actx).
		LogInfo("Egressed %d bytes", len(data)).
		LogInfo("Content name: %s, type: %s", content.Name, content.MediaType)

	for key, value := range input.Metadata {
		result.LogInfo("Metadata - %s: %s", key, value)
	}

	return result
}
