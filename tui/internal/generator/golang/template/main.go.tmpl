func main() {
	actionkit.RunPlugin(&actionkit.PluginConfig{
		Coordinates: &actionkit.PluginCoordinates{
			GroupID:    "{{.GroupID}}",
			ArtifactID: "{{.PluginName}}",
			Version:    version,
		},
		Domain:      "{{.Domain}}",
		Description: description,
	})
}
