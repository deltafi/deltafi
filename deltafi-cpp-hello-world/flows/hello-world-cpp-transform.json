{
  "name": "hello-world-cpp-transform",
  "type": "TRANSFORM",
  "description": "Hello World C++ transform",
  "subscribe": [
    {
      "topic": "hello-world-cpp-transform"
    }
  ],
  "transformActions": [
    {
      "name": "HelloWorldCppTransformAction",
      "type": "org.deltafi.cpp-hello-world.HelloWorldCppTransformAction",
      "parameters": {
        "convertToUpper": "${convertToUpper}",
        "alwaysErrorOnPrefixHit": "${alwaysErrorOnPrefixHit}",
        "alwaysFilterOnPrefixHit": "${alwaysFilterOnPrefixHit}",
        "didErrorPrefix": "${didErrorPrefix}",
        "didFilterPrefix": "${didFilterPrefix}"
      }
    }
  ],
  "publish": {
    "matchingPolicy": "FIRST_MATCHING",
    "defaultRule": {
      "defaultBehavior": "ERROR"
    },
    "rules": [
      {
        "topic": "hello-world-cpp-egress"
      }
    ]
  }
}
